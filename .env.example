# Copy this file to .env and fill in the values. .env is git-ignored.
# Used by `npm run deploy` and `npm run deploy:dry` (Method A).
# GitHub Actions (Method B) reads the same names from repository
# Secrets/Variables instead; see README.

# SSH host name as shown in cPanel > Terminal / SSH Access (placeholder below)
DEPLOY_HOST=your-server.example.com

# SSH port. NameCrane's may NOT be 22: check cPanel > SSH Access.
DEPLOY_PORT=22

# Your cPanel account username
DEPLOY_USER=cpanelusername

# Path to the PRIVATE key you authorized in cPanel (never commit it)
DEPLOY_SSH_KEY=~/.ssh/ke8oir_deploy

# Absolute remote path of the web root. On cPanel this is normally
# /home/<cpanelusername>/public_html. Nothing outside this folder is touched.
DEPLOY_REMOTE_PATH=/home/cpanelusername/public_html
